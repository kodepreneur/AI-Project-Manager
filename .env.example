# AI Project Manager Configuration
APP_NAME="AI Project Manager"
APP_ENV=production
APP_PORT=8080

# Application Database (defaults to SQLite)
DATABASE_URL=./storage/db/app.db

# File Storage Paths
PROJECT_ROOT=./projects
STORAGE_ROOT=./storage

# Antigravity CLI Binary (can be 'antigravity', 'agy', or an absolute binary path)
ANTIGRAVITY_BINARY=antigravity

# Security
JWT_SECRET=replace-with-a-very-long-random-string-in-production

# Feature Flags
TERMINAL_ENABLED=true
SCREENSHOT_ENABLED=true
