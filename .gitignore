# ==============================================================================
# AI Project Manager — Git Ignore Rules
# ==============================================================================

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# ------------------------------------------------------------------------------
# Backend (Go)
# ------------------------------------------------------------------------------
# Compiled binaries & outputs
/backend/server
server
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Test binaries & coverage
*.test
*.out
coverage.out
*.prof

# Go workspace file
go.work
go.work.sum

# ------------------------------------------------------------------------------
# Frontend (Node / Vite / React)
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local

# Frontend package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Storage & Runtime Data
# ------------------------------------------------------------------------------
# SQLite databases
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# Storage subdirectories (preserve directories via .gitkeep)
/storage/db/*
!/storage/db/.gitkeep

/storage/logs/*
!/storage/logs/.gitkeep

/storage/screenshots/*
!/storage/screenshots/.gitkeep

# Application logs
/logs/
*.log

# ------------------------------------------------------------------------------
# Generated User Projects
# ------------------------------------------------------------------------------
# Ignore dynamically created projects managed by the application
/projects/*
!/projects/.gitkeep

# AI / Assistant runtime artifacts
.gemini/
